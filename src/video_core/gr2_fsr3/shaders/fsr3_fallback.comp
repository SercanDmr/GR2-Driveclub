#version 450
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// Scales the colour input into the guest image of the replaced pass without FSR, bilinear or with
// FSR 1 EASU. The source is the top-left src_size region of its image and is read through an sRGB
// view. The result is stored in the component order of the target, with alpha 1 or the luma of
// the colour.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D src_tex;
layout(set = 0, binding = 1) uniform sampler src_sampler;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform FallbackConstants {
    uvec2 dst_size;
    uvec2 src_size;
    uint flags;
    uint components;
} pc;

const uint FALLBACK_EASU = 1u;
const uint FALLBACK_ALPHA_ONE = 2u;

#define A_GPU 1
#define A_GLSL 1
#include "../../host_shaders/fsr/ffx_a.h"

#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) {
    return textureGather(sampler2D(src_tex, src_sampler), p, 0);
}
AF4 FsrEasuGF(AF2 p) {
    return textureGather(sampler2D(src_tex, src_sampler), p, 1);
}
AF4 FsrEasuBF(AF2 p) {
    return textureGather(sampler2D(src_tex, src_sampler), p, 2);
}
#include "../../host_shaders/fsr/ffx_fsr1.h"

#include "fsr3_color.glsl"

void main() {
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, pc.dst_size))) {
        return;
    }
    const vec2 source_size = vec2(pc.src_size);
    const vec2 output_size = vec2(pc.dst_size);
    const vec2 image_size = vec2(textureSize(src_tex, 0));
    vec3 c;
    if ((pc.flags & FALLBACK_EASU) != 0u) {
        AU4 con0;
        AU4 con1;
        AU4 con2;
        AU4 con3;
        FsrEasuCon(con0, con1, con2, con3, source_size.x, source_size.y, image_size.x,
                   image_size.y, output_size.x, output_size.y);
        FsrEasuF(c, gl_GlobalInvocationID.xy, con0, con1, con2, con3);
    } else {
        const vec2 pixel = vec2(gl_GlobalInvocationID.xy) + 0.5;
        const vec2 uv = pixel * source_size / (output_size * image_size);
        c = textureLod(sampler2D(src_tex, src_sampler), uv, 0.0).rgb;
    }
    const float alpha = (pc.flags & FALLBACK_ALPHA_ONE) != 0u ? 1.0 : Fsr3Luma(c);
    imageStore(dst, ivec2(gl_GlobalInvocationID.xy),
               Fsr3Reorder(vec4(Fsr3SrgbEncode(c), alpha), pc.components));
}
