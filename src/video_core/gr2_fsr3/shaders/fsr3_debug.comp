#version 450
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

// Diagnostic views of the FSR inputs, written into the guest image of the replaced pass in its
// component order. Each output pixel shows the nearest render pixel.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D color_tex;
layout(set = 0, binding = 1) uniform texture2D mv_tex;
layout(set = 0, binding = 2) uniform utexture2D stencil_tex;
layout(set = 0, binding = 3) uniform texture2D depth_copy_tex;
layout(set = 0, binding = 4) uniform texture2D depth_main_tex;
layout(set = 0, binding = 5) uniform texture2D reactive_tex;
layout(set = 0, binding = 6) uniform texture2D tc_tex;
layout(set = 0, binding = 7) uniform texture2D history_tex;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D history_out;
layout(set = 0, binding = 9) uniform sampler linear_sampler;
layout(set = 0, binding = 10, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform DebugConstants {
    uvec2 dst_size;
    uvec2 src_size;
    uint view;
    uint flags;
    float near_plane;
    float far_plane;
    vec2 mv_scale;
    uint stencil_red;
    uint stencil_green;
    uint stencil_blue;
    uint components;
} pc;

// fsr3Debug values.
const uint VIEW_MOTION_VECTORS = 1u;
const uint VIEW_STENCIL = 2u;
const uint VIEW_DEPTH = 3u;
const uint VIEW_MASKS = 4u;
const uint VIEW_REPROJECTION = 5u;

const uint DEBUG_HISTORY_VALID = 1u;
const uint DEBUG_DEPTH_COPY = 2u;
const uint DEBUG_DEPTH_MAIN = 4u;

#include "fsr3_color.glsl"

// Distance from the camera for a conventional [0, 1] device depth.
float LinearDepth(float depth) {
    const float n = pc.near_plane;
    const float f = pc.far_plane;
    return 2.0 * n * f / (f + n - (2.0 * clamp(depth, 0.0, 1.0) - 1.0) * (f - n));
}

float DepthGrey(float view_depth) {
    return clamp(log2(view_depth / pc.near_plane) / log2(pc.far_plane / pc.near_plane), 0.0, 1.0);
}

// 0.5 +- pixels / 16 in red and green; an exactly zero motion vector is black.
vec3 MotionVectorView(ivec2 q) {
    const vec2 pixels = texelFetch(mv_tex, q, 0).rg * pc.mv_scale;
    if (all(equal(pixels, vec2(0.0)))) {
        return vec3(0.0);
    }
    return vec3(0.5 + clamp(pixels / 16.0, -0.5, 0.5), 0.5);
}

vec3 StencilView(ivec2 q) {
    const uint s = texelFetch(stencil_tex, q, 0).r;
    return vec3((s & pc.stencil_red) != 0u, (s & pc.stencil_green) != 0u,
                (s & pc.stencil_blue) != 0u);
}

// Grey for the copied depth, or the main depth when only that is bound; red where both are bound
// and differ by more than 1 %.
vec3 DepthView(ivec2 q) {
    const bool has_copy = (pc.flags & DEBUG_DEPTH_COPY) != 0u;
    const bool has_main = (pc.flags & DEBUG_DEPTH_MAIN) != 0u;
    if (!has_copy && !has_main) {
        return vec3(0.0);
    }
    const float copy_depth = has_copy ? LinearDepth(texelFetch(depth_copy_tex, q, 0).r) : 0.0;
    const float main_depth = has_main ? LinearDepth(texelFetch(depth_main_tex, q, 0).r) : 0.0;
    if (has_copy && has_main && abs(copy_depth - main_depth) > 0.01 * copy_depth) {
        const float grey = 0.5 * DepthGrey(copy_depth);
        return vec3(1.0, grey, grey);
    }
    return vec3(DepthGrey(has_copy ? copy_depth : main_depth));
}

// Stores the current colour as the next history and shows 4 x |colour - reprojected history|.
vec3 ReprojectionView(ivec2 q) {
    const vec3 current = texelFetch(color_tex, q, 0).rgb;
    // The first output pixel that maps to q stores it, so each history texel has one writer.
    const uvec2 owner = (uvec2(q) * pc.dst_size + pc.src_size - 1u) / pc.src_size;
    if (all(equal(gl_GlobalInvocationID.xy, owner))) {
        imageStore(history_out, q, vec4(current, 1.0));
    }
    if ((pc.flags & DEBUG_HISTORY_VALID) == 0u) {
        return vec3(0.0);
    }
    const vec2 motion = texelFetch(mv_tex, q, 0).rg * pc.mv_scale;
    const vec2 uv = (vec2(q) + 0.5 + motion) / vec2(pc.src_size);
    const vec3 history = textureLod(sampler2D(history_tex, linear_sampler), uv, 0.0).rgb;
    return clamp(abs(current - history) * 4.0, 0.0, 1.0);
}

void main() {
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, pc.dst_size))) {
        return;
    }
    const ivec2 q = ivec2(gl_GlobalInvocationID.xy * pc.src_size / pc.dst_size);
    vec3 color = vec3(0.0);
    switch (pc.view) {
    case VIEW_MOTION_VECTORS:
        color = MotionVectorView(q);
        break;
    case VIEW_STENCIL:
        color = StencilView(q);
        break;
    case VIEW_DEPTH:
        color = DepthView(q);
        break;
    case VIEW_MASKS:
        color = vec3(texelFetch(reactive_tex, q, 0).r, texelFetch(tc_tex, q, 0).r, 0.0);
        break;
    case VIEW_REPROJECTION:
        color = ReprojectionView(q);
        break;
    default:
        break;
    }
    imageStore(dst, ivec2(gl_GlobalInvocationID.xy),
               Fsr3Reorder(vec4(Fsr3SrgbEncode(color), 1.0), pc.components));
}
